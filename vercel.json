{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "village-vitrine.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(styles.css|app.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/villagedesrecruteurs",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/villagedesrecruteurs/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/events",
      "destination": "/nos-villages/",
      "permanent": true
    },
    {
      "source": "/events/",
      "destination": "/nos-villages/",
      "permanent": true
    },
    {
      "source": "/event/le-village-des-recruteurs-de-toulouse-1",
      "destination": "/nos-villages/toulouse/",
      "permanent": true
    },
    {
      "source": "/event/le-village-des-recruteurs-de-toulouse-1/",
      "destination": "/nos-villages/toulouse/",
      "permanent": true
    },
    {
      "source": "/event/le-village-des-recruteurs-de-dijon-2",
      "destination": "/nos-villages/dijon/",
      "permanent": true
    },
    {
      "source": "/event/le-village-des-recruteurs-de-dijon-2/",
      "destination": "/nos-villages/dijon/",
      "permanent": true
    },
    {
      "source": "/event/le-village-des-recruteurs-d-orleans-3",
      "destination": "/nos-villages/orleans/",
      "permanent": true
    },
    {
      "source": "/event/le-village-des-recruteurs-d-orleans-3/",
      "destination": "/nos-villages/orleans/",
      "permanent": true
    },
    {
      "source": "/event/le-village-des-recruteurs-de-lyon-4",
      "destination": "/nos-villages/lyon/",
      "permanent": true
    },
    {
      "source": "/event/le-village-des-recruteurs-de-lyon-4/",
      "destination": "/nos-villages/lyon/",
      "permanent": true
    },
    {
      "source": "/contact-candidat",
      "destination": "/candidats/",
      "permanent": true
    },
    {
      "source": "/contact-candidat/",
      "destination": "/candidats/",
      "permanent": true
    },
    {
      "source": "/inscription-candidat",
      "destination": "/candidats/",
