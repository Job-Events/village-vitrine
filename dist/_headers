# En-tetes, converties depuis vercel.json.
# Plus de X-Robots-Tag : le site est destine a etre indexe.
# La copie *.pages.dev reste protegee de la cannibalisation par les balises
# canoniques, qui pointent toutes vers www.levillagedesrecruteurs.fr.

# Les images peuvent etre remplacees a chemin constant, contrairement aux
# polices et aux deux actifs qui portent une empreinte dans leur URL. Un cache
# "immutable" d un an y est donc un piege : le 26 aout 2026, deux logos
# redimensionnes sont restes invisibles en ligne alors que le fichier d origine
# etait correct, le cache servant encore l ancienne version.
#
# Un jour de cache, puis service de la version perimee pendant le
# rafraichissement en arriere-plan : le visiteur n attend jamais, et un
# remplacement devient visible en 24 heures sans intervention.
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Ces deux actifs portent une empreinte de contenu dans leur URL, du type
# /app.js?v=ee8a09d8. Leur adresse change donc a chaque modification, ce qui
# autorise un cache long sans risque de servir une version perimee.
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/app.js
  Cache-Control: public, max-age=31536000, immutable

